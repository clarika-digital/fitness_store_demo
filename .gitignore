# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# bun.lock / package-lock.json / pnpm-lock.yaml are intentionally NOT ignored.
# Lockfiles must be committed or installs are not reproducible.

# ---------------------------------------------------------------------------
# Next.js
# ---------------------------------------------------------------------------
# Build output, Turbopack/webpack cache, trace files and the standalone copy
# that scripts/copy-standalone.mjs writes.
/.next/
/out/
/build/
next-env.d.ts

# ---------------------------------------------------------------------------
# TypeScript
# ---------------------------------------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
# .env.example is the committed template; every other .env* stays local.
.env*
!.env.example

# ---------------------------------------------------------------------------
# Prisma / SQLite
# ---------------------------------------------------------------------------
# The schema, seed and migrations ARE committed. Only the local database
# files are not.
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
prisma/*.db
/prisma/*.db-journal

# ---------------------------------------------------------------------------
# Test / coverage output
# ---------------------------------------------------------------------------
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/blob-report/
/.playwright/

# NOTE: `test` and `tests` are deliberately NOT ignored. tests/ contains
# tracked runtime-build scripts. A bare `test` pattern would silently swallow
# any fixture directory or file with that name at any depth.

# ---------------------------------------------------------------------------
# Production / deploy
# ---------------------------------------------------------------------------
.vercel
.netlify
.wrangler
*.pem
*.p12
*.pfx

# ---------------------------------------------------------------------------
# Logs & runtime scratch
# ---------------------------------------------------------------------------
# Covers dev.log, dev.out.log, server.log and any new log name.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Launcher output from scripts/run-next.mjs
/logs/

# Root-anchored scratch files only. A bare `local-*` would also match a real
# source file such as src/local-utils.ts.
/local-*
/tmp/
/temp/
.cache/

# ---------------------------------------------------------------------------
# Editor & OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.fleet/
*.swp
*.swo
*~

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ---------------------------------------------------------------------------
# Local agent / tooling config
# ---------------------------------------------------------------------------
# Root-anchored so a nested folder with the same name is never hidden.
/.claude/
/.z-ai-config/
/skills/

# ---------------------------------------------------------------------------
# Merge / patch leftovers
# ---------------------------------------------------------------------------
*.orig
*.rej
*.bak
*.tmp
